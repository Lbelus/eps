# Copy to .env.local and fill in real values. Do not commit .env.local.
#
# Supabase: auth provider used by lib/supabase/* and components/session/*.
# Get these from your Supabase project's Settings → API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REST API (C++ rest_api/) — origin used by services/search-engine.
# Local dev (dockerized rest_api on host port 3004):
#   NEXT_PUBLIC_REST_API_URL=http://localhost:3004
# Production (path A — nginx TLS terminator in front):
#   NEXT_PUBLIC_REST_API_URL=https://api.eps.example.com
NEXT_PUBLIC_REST_API_URL=http://localhost:3004
