# Copy to rest_api/.env (gitignored) and fill in real values, then:
#   set -a; source rest_api/.env; set +a
#   source rest_api/bash_scripts/helper_script.sh
#
# In production, source these from your secret store (Docker secrets,
# Kubernetes Secret, Vault, AWS Secrets Manager, etc.), not a checked-out
# .env file.

# MySQL root password. Required to bring the container up; used by mysqldump
# in rest_api_backup_db. Generate a strong value, e.g.:
#   MYSQL_ROOT_PASSWORD="$(openssl rand -base64 32)"
MYSQL_ROOT_PASSWORD=

# Application MySQL user used by the REST API binary at runtime.
# config.yaml's `mysql.password: MYSQL_PASSWORD` resolves to this env var
# at server startup (see src/utils/config_loader.cpp).
MYSQL_USER=dev_admin
MYSQL_PASSWORD=
MYSQL_DATABASE=test_rest_DB
